{
  "name": "josjis-it-team",
  "version": "2.2.0",
  "description": "JOSJIS IT TEAM - Internal Secure Communication & Ops Network",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "update": "update.bat"
  },
  "dependencies": {
    "mqtt": "^5.16.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.internal.josjis.it",
    "productName": "JOSJIS IT TEAM",
    "compression": "maximum",
    "asar": true,
    "removePackageScripts": true,
    "files": [
      "main.js",
      "db.js",
      "index.html",
      "mqtt.min.js",
      "socket.io.min.js",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "josjis.exe"
    }
  }
}
